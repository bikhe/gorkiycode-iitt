# Скопируйте в .env и заполните. Секретные значения не хранить в репозитории.

# --- LLM (разбор запроса) ---------------------------------------------------
# gigachat (по умолчанию) | openai | deepseek | openrouter | yandex | ollama
# | openai_compatible (свой адрес в LLM_BASE_URL) | rules (без LLM, отладка)
APP_LLM_PROVIDER=gigachat
# Для всех, кроме gigachat и rules (нужен function calling / tools):
LLM_MODEL=
LLM_API_KEY=
# Пусто — адрес пресета; для openai_compatible обязателен, например http://localhost:8000/v1
LLM_BASE_URL=
LLM_TIMEOUT=45

GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
# Публичный корневой сертификат Минцифры для TLS GigaChat; пусто — системные сертификаты
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt

GIGACHAT_MAX_RETRIES=2
GIGACHAT_RETRY_BACKOFF_FACTOR=0.5
GIGACHAT_TIMEOUT=45

APP_TIMEZONE=Europe/Moscow
APP_DB_PATH=assistant_data.sqlite3
# Origin внешних страниц через запятую (ровно как в адресной строке).
# Страница, которую раздаёт сам FastAPI, разрешена всегда.
APP_CORS_ORIGIN=http://localhost:5500

# Вход: 1 — обязателен (логин/пароль), 0 — отладка, user_id из тела запроса
APP_AUTH_REQUIRED=1
# 0 — закрыть регистрацию новых пользователей
APP_ALLOW_REGISTRATION=1
# 1 — cookie только по HTTPS (на сервере за Caddy)
APP_COOKIE_SECURE=0

# Смысловой поиск: local — локальная модель (по умолчанию, работает и офлайн),
# gigachat — GigaChat Embeddings (нужен тариф с ними), off — только по словам.
# Если модель недоступна — поиск по словам, без ошибок для пользователя.
APP_EMBEDDINGS=local
# Локальная модель: paraphrase-multilingual-mpnet-base-v2 (~1 ГБ, точнее)
# или paraphrase-multilingual-MiniLM-L12-v2 (~0.2 ГБ, для слабого сервера)
APP_EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Папка для скачанной модели (пусто — системная временная папка)
FASTEMBED_CACHE_PATH=models
# Порог сходства; пусто — откалиброванный порог выбранной модели
APP_SEMANTIC_THRESHOLD=
GIGACHAT_EMBEDDINGS_MODEL=Embeddings

# Модель faster-whisper: tiny / base / small / medium
APP_STT_MODEL=small

# --- Озвучивание ответов (TTS) ------------------------------------------------
# browser (по умолчанию) — озвучивает браузер, сервер не участвует
# google — Google Cloud Text-to-Speech через POST /api/tts
# off — без озвучивания
APP_TTS_PROVIDER=browser
GOOGLE_TTS_API_KEY=
# Голоса: https://cloud.google.com/text-to-speech/docs/voices (ru-RU-Wavenet-A…E, ru-RU-Standard-…)
GOOGLE_TTS_VOICE=ru-RU-Wavenet-D
GOOGLE_TTS_LANGUAGE=ru-RU
GOOGLE_TTS_SPEAKING_RATE=1.0
# MP3 | OGG_OPUS | LINEAR16
GOOGLE_TTS_ENCODING=MP3
# 1 — запуск без GigaChat (правиловый парсер, для отладки)
APP_OFFLINE=
